# Telegram bot token from @BotFather. Never commit a real token.
BOT_TOKEN=

# Local Compose default. On Railway use the Postgres service reference variable:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+asyncpg://classmate:classmate@db:5432/classmate

# Comma-separated Telegram numeric IDs allowed to create the first school.
BOOTSTRAP_ADMIN_IDS=

# Default timezone for newly created schools. Each school can override it.
DEFAULT_TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO
REMINDER_POLL_SECONDS=5
